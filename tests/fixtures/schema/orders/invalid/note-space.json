  },
  "texts": {
    "intro": "開店前に、ドの音をまっすぐ流せるか試してほしいんだ。",
    "tutorial": "ベルトは後ろから受けた音を、1 tick に1マス前へ運びます。",
    "result": {
      "encore": "いいね。これなら朝から流せるよ。",
      "pass": "ちゃんと流れてる。もう少し詰められそうだ。",
      "fail": "音が途中で止まってしまったみたい。もう一度見てみよう。"
    }
  },
  "board": {
    "width": 12,
    "height": 8,
    "blocked": []
  },
  "inputs": [
    {
      "id": "A",
      "pos": [0, 3],
