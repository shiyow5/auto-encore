{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiyow5.github.io/auto-encore/schema/solution.schema.json",
  "title": "Auto Encore 解答（模範解 src/data/solutions/*.json・プレイヤーの配置・セーブ共通）",
  "description": "形だけを見る。orderId と注文の一致・盤外・入口出口との重なり・allowedMachines・expected.cost とコスト計算の一致は src/core/sim/load.ts の parseSolution が見る。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "orderId", "name", "placements"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "orderId": {
      "type": "string",
      "pattern": "^order-[0-9]{2}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["machine", "pos", "dir"],
        "properties": {
          "machine": {
            "enum": ["belt", "merger", "sorter", "tuner", "bin"]
          },
          "pos": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "dir": {
            "enum": ["N", "E", "S", "W"]
          },
          "config": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pitch"],
            "properties": {
              "pitch": {
                "enum": ["do", "mi", "so"]
              }
            }
          }
        },
        "if": {
          "type": "object",
          "properties": {
            "machine": {
              "const": "sorter"
            }
          }
        },
        "then": {
          "type": "object",
          "required": ["config"]
        },
        "else": {
          "type": "object",
          "not": {
            "required": ["config"]
          }
        }
      }
    },
    "expected": {
      "description": "模範解だけ。シミュのゴールデン値。メダル・合否は注文の scoring から score.ts が出すのでここに書かない（二重持ちしない）。",
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "accuracy", "ticks", "cost"],
      "properties": {
        "result": {
          "enum": ["completed", "stuck", "loop", "maxTicks"]
        },
        "accuracy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "ticks": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 2000
        },
        "cost": {
          "type": "integer",
          "minimum": 0
        },
        "finalHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "if": {
        "type": "object",
        "properties": {
          "result": {
            "const": "completed"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "ticks": {
            "type": "integer"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "ticks": {
            "type": "null"
          }
        }
      }
    }
  }
}
