{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shiyow5.github.io/auto-encore/schema/order.schema.json",
  "title": "Auto Encore 注文（src/data/orders/*.json）",
  "description": "形（必須キー・型・列挙・範囲）だけを見る。盤外・重なり・メダルの順序など項目をまたぐ条件は src/core/sim/load.ts の parseOrder が見る。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "board",
    "inputs",
    "outputs",
    "allowedMachines",
    "limits",
    "scoring",
    "unlocks",
    "referenceSolutions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/orderId"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "portrait": {
          "description": "public/ からの相対パス（vite の base が \"./\" なので先頭に / を付けない）。実在は CI で確認する。",
          "type": "string",
          "pattern": "^assets/sprites/portraits/[a-z0-9-]+\\.png$"
        }
      }
    },
    "texts": {
      "type": "object"
    },
    "voice": {},
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "blocked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pos"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pos", "dir", "emit"],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "pos": {
            "$ref": "#/$defs/pos"
          },
          "dir": {
            "$ref": "#/$defs/dir"
          },
          "emit": {
            "type": "object",
            "additionalProperties": false,
            "required": ["interval", "notes"],
            "properties": {
              "interval": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "notes": {
                "$ref": "#/$defs/notes"
              }
            }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pos", "dir", "expect"],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "pos": {
            "$ref": "#/$defs/pos"
          },
          "dir": {
            "$ref": "#/$defs/dir"
          },
          "expect": {
            "$ref": "#/$defs/notes"
          }
        }
      }
    },
    "allowedMachines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/machineId"
      }
    },
    "machineCost": {
      "$ref": "#/$defs/machineCountMap"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTicks"],
      "properties": {
        "maxTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        },
        "machines": {
          "$ref": "#/$defs/machineCountMap"
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accuracy", "ticks", "cost", "passRule", "encoreRule"],
      "properties": {
        "accuracy": {
          "$ref": "#/$defs/accuracyMedals"
        },
        "ticks": {
          "$ref": "#/$defs/medals"
        },
        "cost": {
          "$ref": "#/$defs/medals"
        },
        "passRule": {
          "const": "all-bronze-or-better"
        },
        "encoreRule": {
          "const": "two-or-more-gold"
        }
      }
    },
    "unlocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/orderId"
      }
    },
    "referenceSolutions": {
      "description": "src/data/ からの相対パス。自分の注文の解だけ（\"solutions/<id>-<name>.json\"）。",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^solutions/order-[0-9]{2}-[a-z0-9-]+\\.json$"
      }
    }
  },
  "$defs": {
    "orderId": {
      "type": "string",
      "pattern": "^order-[0-9]{2}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "pos": {
      "description": "[x, y]。左上が (0,0)。盤内かどうかは parseOrder が見る。",
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "dir": {
      "enum": ["N", "E", "S", "W"]
    },
    "machineId": {
      "enum": ["belt", "merger", "sorter", "tuner", "bin"]
    },
    "note": {
      "description": "\"音高:長さ\"。最小版の注文で長を弾くかは E-U5 で未決なので、ここでは6種とも通す。",
      "enum": ["do:short", "mi:short", "so:short", "do:long", "mi:long", "so:long"]
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "machineCountMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/machineId"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "medals": {
      "description": "ticks・cost の閾値。小さいほど良い: 値 <= 閾値 でそのメダル（ちょうどは含む）。順序（gold<=silver<=bronze）は parseOrder が見る。",
      "type": "object",
      "additionalProperties": false,
      "required": ["gold", "silver", "bronze"],
      "properties": {
        "gold": {
          "type": "integer",
          "minimum": 0
        },
        "silver": {
          "type": "integer",
          "minimum": 0
        },
        "bronze": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "const": "percent"
        }
      }
    },
    "accuracyMedals": {
      "description": "正確さ（整数 %）。大きいほど良い: 一致数×100 >= 閾値×総数 でそのメダル。",
      "type": "object",
      "additionalProperties": false,
      "required": ["gold", "silver", "bronze"],
      "properties": {
        "gold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "silver": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "bronze": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "unit": {
          "const": "percent"
        }
      }
    }
  }
}
